{
  "name": "human-chat",
  "version": "0.1.0",
  "description": "Short-turn chat reply linter and topic plan reader for agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "human-chat": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
